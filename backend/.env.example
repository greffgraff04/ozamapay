# ── Server ─────────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development
FRONTEND_URL=https://ozamapay.com
BACKEND_URL=https://api.ozamapay.com

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/ozamapay

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=
OZAMAPAY_MASTER_ID=

# ── Sentry Error Tracking ───────────────────────────────────────────────────────
# Ajoute DSN la depi Sentry dashboard apre ou kreye projet la
SENTRY_DSN=

# ── Strowallet (Virtual Cards) ──────────────────────────────────────────────────
STROWALLET_PUBLIC_KEY=
STROWALLET_WEBHOOK_SECRET=

# ── Brevo (Email) ────────────────────────────────────────────────────────────────
BREVO_API_KEY=

# ── ImageKit (KYC Photo Storage) ────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── MonCash (Payment Gateway) ───────────────────────────────────────────────────
MONCASH_CLIENT_ID=
MONCASH_SECRET_KEY=
MONCASH_MODE=sandbox
MONCASH_WEBHOOK_SECRET=
MONCASHCONNECT_SECRET_KEY=
MONCASHCONNECT_WEBHOOK_SECRET=

# ── Reloadly (Gift Cards) ────────────────────────────────────────────────────
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_WEBHOOK_SECRET=

# ── USDT (TRC20) Deposits ────────────────────────────────────────────────────────
# BIP39 mnemonic — HD wallet master seed. Never commit a real value. No
# individual private keys are ever stored in the DB; addresses are
# re-derived from this seed + DepositAddress.derivationIndex on demand.
TRON_MASTER_MNEMONIC=
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io
USDT_TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_MIN_CONFIRMATIONS=20
# Pacing between individual per-address TronGrid checks. Default 1250ms
# (~10.4min full rotation over ~499 addresses) keeps this loop under a
# ~70,000 req/day budget out of the key's 100,000/day quota — lower this
# only if TronGrid grants a higher daily quota.
TRON_MONITOR_REQUEST_INTERVAL_MS=1250

# ── USDT (TRC20) Sweep (Faz 2) ───────────────────────────────────────────────────
# Separate BIP39 mnemonic — treasury/sweep destination wallet. Never
# commit a real value, never reuse TRON_MASTER_MNEMONIC here.
SWEEP_MASTER_MNEMONIC=
SWEEP_GAS_FUNDING_TRX=15
SWEEP_MIN_USDT_THRESHOLD=1
# Automatic sweep safety caps (event-driven trigger + 15-min cron). Above
# either cap, the address/cycle is skipped and left for a manual
# POST /admin/sweep/run — adjust anytime via env, no redeploy needed.
SWEEP_AUTO_MAX_USDT_PER_ADDRESS=250
SWEEP_AUTO_MAX_TOTAL_USDT_PER_CYCLE=1000

# ── USDT Reconciliation (on-chain vs BDD, daily safety net) ──────────────────────
# Small rounding tolerance and pacing for the ~500-call daily/on-demand
# balance check across every DepositAddress + treasury. Alerts only, never
# auto-corrects anything.
RECONCILIATION_TOLERANCE_USDT=0.01
RECONCILIATION_REQUEST_INTERVAL_MS=400

# ── Tron/USDT health monitoring (alert-only, every 15min) ────────────────────────
TRON_HEALTH_MONITOR_STALE_MINUTES=20
TRON_HEALTH_DEPOSIT_STUCK_HOURS=2
TRON_HEALTH_SWEEP_STUCK_HOURS=4
# Self-tracked (TronGrid has no quota-remaining endpoint) — see
# TronUsageService. Raise TRONGRID_DAILY_QUOTA if TronGrid grants a higher plan.
TRONGRID_DAILY_QUOTA=100000
TRONGRID_QUOTA_ALERT_THRESHOLD_PCT=80
# Missing USDT_HTG rate row alerts immediately (silent fallback to $140 is
# already in effect); this only controls the staleness window once a rate exists.
TRON_HEALTH_RATE_STALE_HOURS=24

# ── Google OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
